    "print(f\"filas: {n_antes} -> {len(df_unico)} tras deduplicar\")\n",
    "print(f\"registros únicos y completos (sin ningún nulo): {n_completos}\")\n",
    "print(f\"factor de replicación aparente: {n_antes / n_completos:.1f}x\")"
   ]
